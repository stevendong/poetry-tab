{
  "name": "yijian-poetry-tab",
  "version": "0.3.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "一笺 — 随时令而来的诗意新标签页",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:background": "node tests/background-browser.mjs && node tests/background-loading-browser.mjs && node tests/background-cache-browser.mjs",
    "test:calendar": "node tests/calendar-browser.mjs",
    "test:language": "node tests/language-browser.mjs",
    "check": "node scripts/check.mjs",
    "pack": "node scripts/pack.mjs",
    "preview": "node scripts/preview.mjs",
    "test:online": "node tests/browser-online.mjs",
    "test:api-settings": "node tests/api-settings-browser.mjs",
    "test:specified": "node tests/specified-browser.mjs",
    "test:custom": "xvfb-run -a env HEADFUL=1 node tests/browser-custom.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
